{
  "name": "omp-typesafe-extension",
  "version": "1.0.0",
  "description": "TypeSafe System One planner, verification gate, and human-decision interception extension for oh-my-pi (omp)",
  "type": "module",
  "main": "typesafe-planner.ts",
  "scripts": {
    "test": "bun test",
    "verify:global": "bun tools/verify-omp-global.cjs",
    "verify:live": "bun tools/verify-omp-global.cjs --live",
    "verify:workspace": "bun tools/verify-omp-workspace.cjs",
    "sync:dry-run": "bun tools/sync-baseline.cjs --dry-run",
    "sync:global": "bun tools/sync-baseline.cjs",
    "oneclick": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File ./tools/oneclick-omp.ps1",
    "judge:check": "bun tools/native-judge-setup.cjs --check",
    "judge:apply": "bun tools/native-judge-setup.cjs --apply",
    "judge:start": "bun tools/native-judge-launch.cjs",
    "ck:pm": "node tools/ck-project-manager.cjs"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "typesafe",
    "system-one",
    "ai-agent",
    "evaluation",
    "verification-gate"
  ],
  "author": "thanhnt-sm",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  }
}
